generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(cuid())
  email                   String   @unique
  password                String
  firstName               String
  lastName                String
  subscriptionPlan        String   @default("free") // "free" | "monthly" | "annual"
  subscriptionStatus      String   @default("none") // "none" | "active" | "canceled" | "past_due" | "expired"
  creemSubscriptionId     String?  // Creem subscription ID (sub_xxx)
  creemCustomerId         String?  // Creem customer ID (cust_xxx)
  hasCardOnFile          Boolean  @default(false) // true after user registers card via PayPal
  subscriptionStartDate  DateTime?
  subscriptionEndDate    DateTime?
  trialStartDate         DateTime?  // Starts when user creates first course
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  paymentRequests         PaymentRequest[]
}

model PaymentRequest {
  id            String   @id @default(cuid())
  userId        String
  plan          String   // "monthly" | "annual"
  amount        Int      // amount in cents/units
  currency      String   @default("USD")
  status        String   @default("pending") // "pending" | "approved" | "rejected"
  paymentProof  String?  // optional: screenshot URL or transaction ID
  txRef         String?  // Fondeka transaction reference if available
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
}

model AppSettings {
  id              String   @id @default("main")
  flamePoints     Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model FlameTransaction {
  id          String   @id @default(cuid())
  userId      String?
  amount      Int
  reason      String
  courseId    String?
  chapterId   String?
  createdAt   DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  userId      String?
  title       String
  description String   @default("")
  sourceLinks String   @default("[]")
  level       Int      @default(0)
  flameCost   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chapters    Chapter[]
  finalQuiz   CourseQuiz?
  progress    CourseProgress?
  sessions    StudySession[]
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  content   String
  summary   String   @default("")
  order     Int
  level     Int      @default(0)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz      Quiz?
  progress  ChapterProgress?
}

model Quiz {
  id        String   @id @default(cuid())
  questions String
  chapterId String   @unique
  chapter   Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model ChapterProgress {
  id           String    @id @default(cuid())
  chapterId    String    @unique
  chapter      Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  completed    Boolean   @default(false)
  score        Int       @default(0)
  completedAt  DateTime?
  flameAwarded Boolean   @default(false)
}

model CourseQuiz {
  id        String @id @default(cuid())
  questions String
  courseId  String @unique
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseProgress {
  id                String         @id @default(cuid())
  courseId          String         @unique
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completed         Boolean        @default(false)
  score             Int            @default(0)
  passedAt          DateTime?
  flameAwarded      Boolean        @default(false)
  flameAwardedLevels String        @default("[]")
  maxUnlockedLevel  Int            @default(0)
  stoppedAtLevel    Int            @default(-1)
  sessions          StudySession[]
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  type      String   @default("general") // "bug_report" | "feature_request" | "question" | "general"
  subject   String
  message   String
  email     String?
  page      String?
  metadata  String   @default("{}")
  status    String   @default("new") // "new" | "read" | "resolved" | "dismissed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String?
  chapterId       String?
  courseId        String
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseProgress  CourseProgress? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  durationSeconds Int      @default(0)
}
