{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/vercel-build.js && next build",
  "installCommand": "bun install",
  "devCommand": "next dev -p 3000",
  "functions": {
    "src/app/api/courses/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/courses/*/generate-level/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/courses/*/final-quiz/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
